# ── Supabase connection (Phase 0) ─────────────────────────────────────────
# Copy this file to ".env.local" and fill in the two values from your Supabase
# project. In Supabase: Project Settings → API (or "API Keys").
#
# These are also the values you paste into Vercel (Project → Settings →
# Environment Variables) so the live site can reach the same database.
#
# Both are safe to expose to the browser — real security comes from Supabase
# Row Level Security, not from hiding these.

# Your project URL, e.g. https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" public API key (a long string).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
